<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>NexusSelfHost</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <!-- Override on command line: dotnet build -p:RustManagedPath="C:\svr1\RustDedicated_Data\Managed" -->
    <RustManagedPath Condition="'$(RustManagedPath)' == ''">$(MSBuildThisFileDirectory)..\..\..\RustDedicated_Data\Managed</RustManagedPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Rust.Harmony">
      <HintPath>$(RustManagedPath)\Rust.Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(RustManagedPath)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Facepunch.Nexus">
      <HintPath>$(RustManagedPath)\Facepunch.Nexus.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Net.Http">
      <HintPath>$(RustManagedPath)\System.Net.Http.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RustManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System">
      <HintPath>$(RustManagedPath)\System.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
