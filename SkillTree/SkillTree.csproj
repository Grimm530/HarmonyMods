<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RustManaged Condition="'$(RustManaged)' == ''">$(ENV:RUST_MANAGED_PATH)</RustManaged>
    <RustManaged Condition="'$(RustManaged)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\RustDedicated_Data\Managed'))</RustManaged>
  </PropertyGroup>
  <PropertyGroup>
    <AssemblyName>SkillTree</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <RootNamespace>SkillTreeHarmony</RootNamespace>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Harmony mod: SkillTree 1.7.x (Oxide port). Config: HarmonyConfig/SkillTree.json. Data: HarmonyData/ (default SkillTree subfolder) or CustomSkillTreeDataDirectory in config (currently C:\!DataPersistence\oxide\data\SkillTree). Requires Permissions mod.</Description>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <!-- Krafs.Publicizer makes all Rust types accessible without reflection -->
  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.2.1" PrivateAssets="all" />
    <Publicize Include="Assembly-CSharp" IncludeVirtualMembers="true" IncludeCompilerGeneratedMembers="true" />
  </ItemGroup>
  <!-- Core Rust / HarmonyLib assemblies -->
  <ItemGroup>
    <Reference Include="Rust.Harmony">
      <HintPath>$(RustManaged)\Rust.Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(RustManaged)\Assembly-CSharp-firstpass.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(RustManaged)\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RustManaged)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <!-- Facepunch -->
    <Reference Include="Facepunch.System">
      <HintPath>$(RustManaged)\Facepunch.System.dll</HintPath>
    </Reference>
    <Reference Include="Facepunch.Unity" Condition="Exists('$(RustManaged)\Facepunch.Unity.dll')">
      <HintPath>$(RustManaged)\Facepunch.Unity.dll</HintPath>
    </Reference>
    <Reference Include="Facepunch.UnityEngine">
      <HintPath>$(RustManaged)\Facepunch.UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="Facepunch.Network">
      <HintPath>$(RustManaged)\Facepunch.Network.dll</HintPath>
    </Reference>
    <Reference Include="Facepunch.Console">
      <HintPath>$(RustManaged)\Facepunch.Console.dll</HintPath>
    </Reference>
    <Reference Include="Facepunch.Flexbox" Condition="Exists('$(RustManaged)\Facepunch.Flexbox.dll')">
      <HintPath>$(RustManaged)\Facepunch.Flexbox.dll</HintPath>
    </Reference>
    <!-- Rust -->
    <Reference Include="Rust.Data">
      <HintPath>$(RustManaged)\Rust.Data.dll</HintPath>
    </Reference>
    <Reference Include="Rust.Global">
      <HintPath>$(RustManaged)\Rust.Global.dll</HintPath>
    </Reference>
    <Reference Include="Rust.World">
      <HintPath>$(RustManaged)\Rust.World.dll</HintPath>
    </Reference>
    <Reference Include="Rust.Localization">
      <HintPath>$(RustManaged)\Rust.Localization.dll</HintPath>
    </Reference>
    <!-- JSON -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(RustManaged)\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <!-- Unity -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RustManaged)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(RustManaged)\UnityEngine.UIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RustManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(RustManaged)\UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(RustManaged)\UnityEngine.ImageConversionModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(RustManaged)\UnityEngine.AIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(RustManaged)\UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.VehiclesModule">
      <HintPath>$(RustManaged)\UnityEngine.VehiclesModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TerrainModule">
      <HintPath>$(RustManaged)\UnityEngine.TerrainModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TerrainPhysicsModule">
      <HintPath>$(RustManaged)\UnityEngine.TerrainPhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(RustManaged)\UnityEngine.UnityWebRequestModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestTextureModule">
      <HintPath>$(RustManaged)\UnityEngine.UnityWebRequestTextureModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestWWWModule">
      <HintPath>$(RustManaged)\UnityEngine.UnityWebRequestWWWModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule" Condition="Exists('$(RustManaged)\UnityEngine.InputLegacyModule.dll')">
      <HintPath>$(RustManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
  </ItemGroup>
  <!-- SDK auto-includes all *.cs files; no explicit Compile items needed. -->
</Project>
