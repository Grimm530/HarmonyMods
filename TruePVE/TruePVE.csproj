<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RustManaged Condition="'$(RustManaged)' == ''">$(ENV:RUST_MANAGED_PATH)</RustManaged>
    <RustManaged Condition="'$(RustManaged)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\RustDedicated_Data\Managed'))</RustManaged>
  </PropertyGroup>
  <PropertyGroup>
    <AssemblyName>TruePVE</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <RootNamespace>TruePVEHarmony</RootNamespace>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Harmony mod: TruePVE 2.4.31 (Oxide 2.4.3 port). RuleSets own damage; optional server.pve browser tag with vanilla reflect suppressed. Config: HarmonyConfig/TruePVE.json.</Description>
    <Nullable>disable</Nullable>
    <!-- OXIDE_PUBLICIZED: enable #if blocks that need publicized game fields (e.g. RidableHorse ragdoll). -->
    <DefineConstants>$(DefineConstants);OXIDE_PUBLICIZED</DefineConstants>
    <!-- Compile against the game's own framework facades (net48 reference assemblies lack the
         ReadOnlySpan / Index / Range surface used by current Assembly-CSharp RPC signatures). -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
  </PropertyGroup>
  <!-- Reference assemblies come from the game install; never copy them to output (deploy only TruePVE.dll). -->
  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>
  <!-- Krafs.Publicizer makes all Rust types accessible without reflection -->
  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.2.1" PrivateAssets="all" />
    <Publicize Include="Assembly-CSharp" IncludeVirtualMembers="true" IncludeCompilerGeneratedMembers="true" />
  </ItemGroup>
  <!-- Core Rust / HarmonyLib assemblies -->
  <ItemGroup>
    <Reference Include="Rust.Harmony">
      <HintPath>$(RustManaged)\Rust.Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(RustManaged)\Assembly-CSharp-firstpass.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(RustManaged)\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RustManaged)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <!-- Facepunch -->
    <Reference Include="Facepunch.System">
      <HintPath>$(RustManaged)\Facepunch.System.dll</HintPath>
    </Reference>
    <Reference Include="Facepunch.Unity" Condition="Exists('$(RustManaged)\Facepunch.Unity.dll')">
      <HintPath>$(RustManaged)\Facepunch.Unity.dll</HintPath>
    </Reference>
    <Reference Include="Facepunch.UnityEngine">
      <HintPath>$(RustManaged)\Facepunch.UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="Facepunch.Network">
      <HintPath>$(RustManaged)\Facepunch.Network.dll</HintPath>
    </Reference>
    <Reference Include="Facepunch.Console">
      <HintPath>$(RustManaged)\Facepunch.Console.dll</HintPath>
    </Reference>
    <!-- Rust -->
    <Reference Include="Rust.Data">
      <HintPath>$(RustManaged)\Rust.Data.dll</HintPath>
    </Reference>
    <Reference Include="Rust.Global">
      <HintPath>$(RustManaged)\Rust.Global.dll</HintPath>
    </Reference>
    <Reference Include="Rust.World" Condition="Exists('$(RustManaged)\Rust.World.dll')">
      <HintPath>$(RustManaged)\Rust.World.dll</HintPath>
    </Reference>
    <Reference Include="Rust.Clans" Condition="Exists('$(RustManaged)\Rust.Clans.dll')">
      <HintPath>$(RustManaged)\Rust.Clans.dll</HintPath>
    </Reference>
    <Reference Include="Rust.Localization" Condition="Exists('$(RustManaged)\Rust.Localization.dll')">
      <HintPath>$(RustManaged)\Rust.Localization.dll</HintPath>
    </Reference>
    <!-- Framework facades from the game Managed folder (DisableImplicitFrameworkReferences=true above).
         These provide ReadOnlySpan, Index, Range, KeyValuePair.Deconstruct, Dictionary.GetValueOrDefault. -->
    <Reference Include="mscorlib">
      <HintPath>$(RustManaged)\mscorlib.dll</HintPath>
    </Reference>
    <Reference Include="System">
      <HintPath>$(RustManaged)\System.dll</HintPath>
    </Reference>
    <Reference Include="System.Core">
      <HintPath>$(RustManaged)\System.Core.dll</HintPath>
    </Reference>
    <Reference Include="System.Memory">
      <HintPath>$(RustManaged)\System.Memory.dll</HintPath>
    </Reference>
    <Reference Include="System.Runtime">
      <HintPath>$(RustManaged)\System.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="netstandard">
      <HintPath>$(RustManaged)\netstandard.dll</HintPath>
    </Reference>
    <Reference Include="System.Runtime.CompilerServices.Unsafe">
      <HintPath>$(RustManaged)\System.Runtime.CompilerServices.Unsafe.dll</HintPath>
    </Reference>
    <!-- JSON -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(RustManaged)\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <!-- Unity -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RustManaged)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RustManaged)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(RustManaged)\UnityEngine.UIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(RustManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(RustManaged)\UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(RustManaged)\UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(RustManaged)\UnityEngine.AIModule.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="EnsureRustManaged" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(RustManaged)' == '' Or !Exists('$(RustManaged)\Assembly-CSharp.dll')"
           Text="Could not find Rust Managed folder (Assembly-CSharp.dll). Build with: dotnet build -p:RustManaged=&quot;D:\your\RustDedicated_Data\Managed&quot;" />
  </Target>
  <ItemGroup>
    <Compile Include="..\Shared\BaseEntityFlagCompat.cs" Link="Shared\BaseEntityFlagCompat.cs" />
  </ItemGroup>
</Project>
