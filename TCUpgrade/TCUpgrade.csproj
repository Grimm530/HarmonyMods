<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RustManaged Condition="'$(RustManaged)' == ''">$(ENV:RUST_MANAGED_PATH)</RustManaged>
    <RustManaged Condition="'$(RustManaged)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\RustDedicated_Data\Managed'))</RustManaged>
  </PropertyGroup>
  <PropertyGroup>
    <AssemblyName>TCUpgrade</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>TCUpgrade</RootNamespace>
    <Description>Harmony mod: TCUpgrade - upgrade, repair, reskin, wallpaper. Standalone, no Harmony mod. Config: HarmonyConfig/TCUpgrade.json</Description>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>
  <ItemGroup>
    <Reference Include="Rust.Harmony">
      <HintPath>$(RustManaged)\Rust.Harmony.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(RustManaged)\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RustManaged)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RustManaged)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(RustManaged)\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="Facepunch.UnityEngine">
      <HintPath>$(RustManaged)\Facepunch.UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="Facepunch.Network">
      <HintPath>$(RustManaged)\Facepunch.Network.dll</HintPath>
    </Reference>
    <Reference Include="Facepunch.Console">
      <HintPath>$(RustManaged)\Facepunch.Console.dll</HintPath>
    </Reference>
    <Reference Include="Facepunch.System">
      <HintPath>$(RustManaged)\Facepunch.System.dll</HintPath>
    </Reference>
    <Reference Include="Rust.Data">
      <HintPath>$(RustManaged)\Rust.Data.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(RustManaged)\UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="Rust.Global">
      <HintPath>$(RustManaged)\Rust.Global.dll</HintPath>
    </Reference>
    <Reference Include="Rust.Localization">
      <HintPath>$(RustManaged)\Rust.Localization.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="0GrimmCUI"><HintPath>..\..\..\HarmonyMods\0GrimmCUI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup><Compile Remove="TCUpgrade\Patches\Cui_Endtest_Patch.cs" /></ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\StringViewCompat.cs" Link="StringViewCompat.cs" />
    <Compile Include="..\Shared\BuildingBlockCompat.cs" Link="BuildingBlockCompat.cs" />
  </ItemGroup>
  <Target Name="EnsureRustManaged" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(RustManaged)' == '' Or !Exists('$(RustManaged)\Assembly-CSharp.dll')"
           Text="Could not find Rust Managed folder (Assembly-CSharp.dll). Build with: dotnet build -p:RustManaged=&quot;C:\svr1\RustDedicated_Data\Managed&quot;" />
  </Target>
</Project>
