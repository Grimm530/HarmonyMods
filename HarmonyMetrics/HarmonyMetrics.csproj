<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RustManaged Condition="'$(RustManaged)' == ''">$(ENV:RUST_MANAGED_PATH)</RustManaged>
    <RustManaged Condition="'$(RustManaged)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\RustDedicated_Data\Managed'))</RustManaged>
  </PropertyGroup>
  <PropertyGroup>
    <AssemblyName>HarmonyMetrics</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <RootNamespace>HarmonyMetrics</RootNamespace>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Description>Harmony mod: InfluxDB metrics for Harmony servers (no Oxide). Samples Performance / PerformanceMetrics / RuntimeProfiler and loaded HarmonyMods.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>
  <ItemGroup>
    <PackageReference Include="Krafs.Publicizer" Version="2.2.1" PrivateAssets="all" />
    <Publicize Include="Assembly-CSharp" IncludeVirtualMembers="true" IncludeCompilerGeneratedMembers="true" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(RustManaged)\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Rust.Harmony">
      <HintPath>$(RustManaged)\Rust.Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RustManaged)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(RustManaged)\Assembly-CSharp-firstpass.dll</HintPath>
    </Reference>
    <Reference Include="Facepunch.Console">
      <HintPath>$(RustManaged)\Facepunch.Console.dll</HintPath>
    </Reference>
    <Reference Include="Facepunch.Network">
      <HintPath>$(RustManaged)\Facepunch.Network.dll</HintPath>
    </Reference>
    <Reference Include="Facepunch.Raknet">
      <HintPath>$(RustManaged)\Facepunch.Raknet.dll</HintPath>
    </Reference>
    <Reference Include="Facepunch.System">
      <HintPath>$(RustManaged)\Facepunch.System.dll</HintPath>
    </Reference>
    <Reference Include="Facepunch.Unity">
      <HintPath>$(RustManaged)\Facepunch.Unity.dll</HintPath>
    </Reference>
    <Reference Include="Facepunch.UnityEngine">
      <HintPath>$(RustManaged)\Facepunch.UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(RustManaged)\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="Rust.Data">
      <HintPath>$(RustManaged)\Rust.Data.dll</HintPath>
    </Reference>
    <Reference Include="Rust.Global">
      <HintPath>$(RustManaged)\Rust.Global.dll</HintPath>
    </Reference>
    <Reference Include="mscorlib">
      <HintPath>$(RustManaged)\mscorlib.dll</HintPath>
    </Reference>
    <Reference Include="System">
      <HintPath>$(RustManaged)\System.dll</HintPath>
    </Reference>
    <Reference Include="System.Core">
      <HintPath>$(RustManaged)\System.Core.dll</HintPath>
    </Reference>
    <Reference Include="System.Memory">
      <HintPath>$(RustManaged)\System.Memory.dll</HintPath>
    </Reference>
    <Reference Include="System.Runtime">
      <HintPath>$(RustManaged)\System.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="netstandard">
      <HintPath>$(RustManaged)\netstandard.dll</HintPath>
    </Reference>
    <Reference Include="System.Runtime.CompilerServices.Unsafe">
      <HintPath>$(RustManaged)\System.Runtime.CompilerServices.Unsafe.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(RustManaged)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RustManaged)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule">
      <HintPath>$(RustManaged)\UnityEngine.UnityWebRequestModule.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="EnsureRustManaged" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(RustManaged)' == '' Or !Exists('$(RustManaged)\Assembly-CSharp.dll')"
           Text="Could not find Rust Managed folder (Assembly-CSharp.dll). Build with: dotnet build -p:RustManaged=&quot;D:\your\RustDedicated_Data\Managed&quot;" />
  </Target>
</Project>
