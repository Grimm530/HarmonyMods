<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>NexusStaticPortals</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <RustManagedPath Condition="'$(RustManagedPath)' == ''">$(MSBuildThisFileDirectory)..\..\..\RustDedicated_Data\Managed</RustManagedPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Rust.Harmony">
      <HintPath>$(RustManagedPath)\Rust.Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(RustManagedPath)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RustManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Facepunch.System">
      <HintPath>$(RustManagedPath)\Facepunch.System.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Facepunch.UnityEngine">
      <HintPath>$(RustManagedPath)\Facepunch.UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Facepunch.Network">
      <HintPath>$(RustManagedPath)\Facepunch.Network.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Rust.Data">
      <HintPath>$(RustManagedPath)\Rust.Data.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Rust.Localization">
      <HintPath>$(RustManagedPath)\Rust.Localization.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RustManagedPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(RustManagedPath)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System">
      <HintPath>$(RustManagedPath)\System.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
