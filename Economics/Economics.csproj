<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Economics</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <RootNamespace>EconomicsHarmony</RootNamespace>
    <Description>Harmony mod: Economics Extended 3.10.4 (Oxide-free). Config: HarmonyConfig/Economics.json</Description>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>
    <RustManaged Condition="'$(RustManaged)' == ''">$(MSBuildProjectDirectory)\..\..\..\RustDedicated_Data\Managed</RustManaged>
    <SqliteHint Condition="Exists('$(MSBuildThisFileDirectory)..\Rust-Server-Metrics-master\deps\windows\System.Data.SQLite.dll')">$(MSBuildThisFileDirectory)..\Rust-Server-Metrics-master\deps\windows\System.Data.SQLite.dll</SqliteHint>
    <SqliteHint Condition="'$(SqliteHint)' == '' And Exists('$(MSBuildThisFileDirectory)..\..\Oxide.Plugins.Cant-Use\Oxide\Oxide.SQLite-master\src\Dependencies\System.Data.SQLite.dll')">$(MSBuildThisFileDirectory)..\..\Oxide.Plugins.Cant-Use\Oxide\Oxide.SQLite-master\src\Dependencies\System.Data.SQLite.dll</SqliteHint>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Rust.Harmony">
      <HintPath>$(RustManaged)\Rust.Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(RustManaged)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RustManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Facepunch.System">
      <HintPath>$(RustManaged)\Facepunch.System.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Facepunch.Console">
      <HintPath>$(RustManaged)\Facepunch.Console.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Facepunch.UnityEngine">
      <HintPath>$(RustManaged)\Facepunch.UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Facepunch.Network">
      <HintPath>$(RustManaged)\Facepunch.Network.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rust.Global">
      <HintPath>$(RustManaged)\Rust.Global.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(RustManaged)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RustManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Net.Http">
      <HintPath>$(RustManaged)\System.Net.Http.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Data">
      <HintPath>$(RustManaged)\System.Data.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Data.SQLite">
      <HintPath>$(SqliteHint)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
