<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RustManaged Condition="'$(RustManaged)' == ''">$(ENV:RUST_MANAGED_PATH)</RustManaged>
    <RustManaged Condition="'$(RustManaged)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\RustDedicated_Data\Managed'))</RustManaged>
  </PropertyGroup>
  <PropertyGroup>
    <AssemblyName>NoActiveItemDrop</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Description>Harmony mod: keep the held item on death (no active-item drop).</Description>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RustManaged)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(RustManaged)\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Rust.Harmony">
      <HintPath>$(RustManaged)\Rust.Harmony.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="EnsureRustManaged" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(RustManaged)' == '' Or !Exists('$(RustManaged)\Assembly-CSharp.dll')"
           Text="Could not find Rust Managed folder (Assembly-CSharp.dll). Build with: dotnet build -p:RustManaged=&quot;D:\your\RustDedicated_Data\Managed&quot;" />
  </Target>
</Project>
