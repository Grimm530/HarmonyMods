<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Vanish</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net48</TargetFramework>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
  </PropertyGroup>
  <PropertyGroup>
    <ManagedPath Condition="'$(ManagedPath)' == ''">$(MSBuildProjectDirectory)\..\..\..\RustDedicated_Data\Managed</ManagedPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="mscorlib">
      <HintPath>$(ManagedPath)\mscorlib.dll</HintPath>
    </Reference>
    <Reference Include="System.Runtime">
      <HintPath>$(ManagedPath)\System.Runtime.dll</HintPath>
    </Reference>
    <Reference Include="System.Memory">
      <HintPath>$(ManagedPath)\System.Memory.dll</HintPath>
    </Reference>
    <Reference Include="netstandard">
      <HintPath>$(ManagedPath)\netstandard.dll</HintPath>
    </Reference>
    <Reference Include="System.Runtime.CompilerServices.Unsafe">
      <HintPath>$(ManagedPath)\System.Runtime.CompilerServices.Unsafe.dll</HintPath>
    </Reference>
    <Reference Include="System">
      <HintPath>$(ManagedPath)\System.dll</HintPath>
    </Reference>
    <Reference Include="System.Core" />
    <Reference Include="Rust.Harmony">
      <HintPath>$(ManagedPath)\Rust.Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedPath)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ManagedPath)\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Facepunch.System">
      <HintPath>$(ManagedPath)\Facepunch.System.dll</HintPath>
    </Reference>
    <Reference Include="Facepunch.Network">
      <HintPath>$(ManagedPath)\Facepunch.Network.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedPath)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="Facepunch.Console">
      <HintPath>$(ManagedPath)\Facepunch.Console.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedPath)\UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedPath)\UnityEngine.ImageConversionModule.dll</HintPath>
    </Reference>
    <Reference Include="Facepunch.UnityEngine">
      <HintPath>$(ManagedPath)\Facepunch.UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="Rust.Global">
      <HintPath>$(ManagedPath)\Rust.Global.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ManagedPath)\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(ManagedPath)\Assembly-CSharp-firstpass.dll</HintPath>
    </Reference>
    <Reference Include="Rust.Data">
      <HintPath>$(ManagedPath)\Rust.Data.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
